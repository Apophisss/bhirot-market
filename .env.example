# --- מסד נתונים (libSQL / Turso) ---
# פיתוח מקומי: קובץ SQLite. פרודקשן (Vercel): כתובת Turso + טוקן.
DATABASE_URL="file:./data/local.db"
# DATABASE_URL="libsql://<db-name>-<org>.turso.io"
# DATABASE_AUTH_TOKEN="..."

# --- Auth.js (התחברות עם גוגל) ---
# צרו OAuth Client ב-Google Cloud Console (Web application)
# Authorized redirect URI: https://<domain>/api/auth/callback/google  (ובפיתוח: http://localhost:3000/api/auth/callback/google)
AUTH_SECRET="הריצו: openssl rand -base64 32"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# AUTH_URL="https://<domain>"   # נדרש רק אם Auth.js לא מזהה את הדומיין לבד
# כניסת פיתוח ללא גוגל (כפתור "כניסה מהירה"). רק במחשב שלכם.
# בבילד פרודקשן (next build/start, Vercel) הכניסה הזו כבויה גם אם הערך true.
ALLOW_DEV_LOGIN="true"

# --- טוקנים לעדכון תוכן ---
# מגן על /api/sync ו-/api/admin/* (רוטינת העדכון של המערכת שולחת אותו ב-Authorization: Bearer)
ADMIN_TOKEN="הריצו: openssl rand -hex 32"
# Vercel Cron שולח את זה אוטומטית אם מגדירים CRON_SECRET בפרויקט
CRON_SECRET=""

# --- עמוד הניהול (/admin) ---
# הכניסה ל-/admin היא עם ה-ADMIN_TOKEN שלמעלה (הוא נשמר כקוקי חתום, לא כטוקן עצמו).
# לחלופין: רשימת אימיילים שמורשים להיכנס אחרי התחברות רגילה עם Google, מופרדים בפסיק.
ADMIN_EMAILS=""
# בפיתוח מקומי, כשאין ADMIN_TOKEN ואין ADMIN_EMAILS — /admin פתוח. בפרודקשן הוא תמיד חסום.

# --- אנליטיקה ---
# מלח לגיבוב המבקרים (IP+דפדפן -> hash יומי, בלי קוקי ובלי שמירת IP). ברירת מחדל: AUTH_SECRET.
ANALYTICS_SALT=""
# כמה ימים לשמור אירועים לפני שה-cron השעתי מוחק אותם (ברירת מחדל 180)
ANALYTICS_RETENTION_DAYS="180"
# כיבוי מוחלט של המעקב (לדוגמה בסביבת בדיקות)
ANALYTICS_DISABLED="false"

# --- מחולל השאלות המובנה (אופציונלי) ---
# אם מוגדר, /api/cron/refresh מריץ את מחולל השאלות עם חיפוש באינטרנט ומוסיף שאלות חדשות פעם בשעה
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-opus-5"

# כתובת האתר (לקישורים ולרוטינה)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
