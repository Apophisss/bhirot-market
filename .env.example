# --- מסד נתונים (libSQL / Turso) ---
# פיתוח מקומי: קובץ SQLite. פרודקשן (Vercel): כתובת Turso + טוקן.
DATABASE_URL="file:./data/local.db"
# DATABASE_URL="libsql://<db-name>-<org>.turso.io"
# DATABASE_AUTH_TOKEN="..."

# --- Auth.js (התחברות עם גוגל) ---
# צרו OAuth Client ב-Google Cloud Console (Web application)
# Authorized redirect URI: https://<domain>/api/auth/callback/google  (ובפיתוח: http://localhost:3000/api/auth/callback/google)
AUTH_SECRET="הריצו: openssl rand -base64 32"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# AUTH_URL="https://<domain>"   # נדרש רק אם Auth.js לא מזהה את הדומיין לבד
# כניסת פיתוח ללא גוגל (כפתור "כניסה מהירה"). רק במחשב שלכם.
# בבילד פרודקשן (next build/start, Vercel) הכניסה הזו כבויה גם אם הערך true.
ALLOW_DEV_LOGIN="true"

# --- טוקנים לעדכון תוכן ---
# מגן על /api/sync ו-/api/admin/* (רוטינת העדכון של המערכת שולחת אותו ב-Authorization: Bearer)
ADMIN_TOKEN="הריצו: openssl rand -hex 32"
# Vercel Cron שולח את זה אוטומטית אם מגדירים CRON_SECRET בפרויקט
CRON_SECRET=""

# --- מחולל השאלות המובנה (אופציונלי) ---
# אם מוגדר, /api/cron/refresh מריץ את מחולל השאלות עם חיפוש באינטרנט ומוסיף שאלות חדשות פעם בשעה
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-opus-5"

# --- גרף היסטורי משוער (אומדן טרום־מסחר) ---
# בשוק שעדיין לא נסחר יש נקודת מחיר אחת בלבד, והגרף שטוח. המערכת מציירת לפניה
# קו מקווקו של אומדן — דטרמיניסטי לכל שוק, לתצוגה בלבד, ולעולם לא נשמר במסד הנתונים.
# האומדן אף פעם לא מתרחק מהמחיר הרשום ביותר מ-SYNTHETIC_HISTORY_MAX_DEV (תקרה קשיחה: 0.05),
# ופחות מכך בשווקים קרובים ל-0 או ל-1. המחיר הנוכחי, כל עסקה וכל הכרעה — אמיתיים תמיד.
# SYNTHETIC_HISTORY="off"              # כיבוי מוחלט: הגרף חוזר להציג רק נתונים אמיתיים
# SYNTHETIC_HISTORY_MAX_DEV="0.03"     # סטייה מרבית מהמחיר הרשום (ברירת מחדל 3 נקודות אחוז)
# SYNTHETIC_HISTORY_WINDOW_DAYS="30"   # כמה ימים אחורה האומדן מגיע לכל היותר
# SYNTHETIC_HISTORY_FILL_GAPS="off"    # אומדן רק לפני פתיחת השוק, בלי למלא פערים בין עסקאות
# SYNTHETIC_HISTORY_SALT="bhirot-2026" # שינוי הערך משנה את צורת כל הגרפים — לא לשנות אחרי עלייה לאוויר

# כתובת האתר (לקישורים, ל-SEO ולרוטינה). חייבת להיות הכתובת הפומבית המלאה בפרודקשן —
# ממנה נגזרים canonical, sitemap.xml, robots.txt וה-JSON-LD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- SEO (אופציונלי) ---
# קוד האימות של Google Search Console (התג meta name="google-site-verification")
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# --- Google Analytics (אופציונלי) ---
# מזהה המדידה של זרם הנתונים ב-GA4 (Admin → Data streams → Measurement ID), בפורמט G-XXXXXXXXXX.
# בלי הערך הזה שום סקריפט של גוגל לא נטען בכלל. הערך נצרב לבאנדל בזמן הבילד, לא בזמן ריצה:
# בדוקר צריך להעביר אותו כ-build arg (ראו Dockerfile ו-.github/workflows/deploy.yml),
# ובשינוי הערך צריך בילד מחדש.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
